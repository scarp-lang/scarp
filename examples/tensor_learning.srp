pure funcra identity<T>(value: T) -> T {
    return value;
}

bind features: tensor<float, 2, 2> = [[1.0, 2.0], [3.0, 4.0]];
bind weights: tensor<float, 2, 1> = [[0.5], [1.0]];
bind scores = identity(matmul(features, weights));
bind result = tensor_value_grad(weights, tensor_sum(tensor_square(matmul(features, weights))));
bind next_weights = tensor_sgd(weights, result[1], 0.01);
print(scores, result[0]);
print(result[1], next_weights);

bind x = 3.0;
bind offset = 2.0;
print(value_grad(x, scalar_square(x) + x * offset));
