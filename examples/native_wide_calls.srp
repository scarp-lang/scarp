pure funcra wide(a: integer, b: integer, c: integer, d: integer, e: integer, f: integer, g: integer, h: integer) -> integer {
    return a + b + c + d + e + f + 2 * g + 3 * h;
}

pure funcra entry(n: integer) -> integer {
    var total = n;
    repeat 2 as pass {
        total += wide(h: n + pass, g: pass, f: 6, e: 5, d: 4, c: 3, b: 2, a: 1);
    }
    return total;
}

print(entry(2), entry(4));
