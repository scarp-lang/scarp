// A small UI-like routing decision without a graphical runtime.
// Open-ended integer and string domains require an explicit fallback.
pure funcra action_label(code: integer) -> string {
    match on code {
        case 0 { return "Open"; }
        case 1 { return "Save"; }
        case -1 { return "Cancel"; }
        case _ { return "Unknown action"; }
    }
}

pure funcra menu_kind(title: string) -> string {
    match on title {
        case "File" { return "menu"; }
        case "Save" { return "action"; }
        case "" { return "untitled"; }
        case _ { return "other"; }
    }
}

print(action_label(1));
print(action_label(17));
print(menu_kind("File"));
print(menu_kind("नमस्ते"));
